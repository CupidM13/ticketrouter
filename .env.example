# TicketRouter Environment Configuration

# Base Model for LoRA Fine-Tuning and Inference
BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Gemini Fallback API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# MLflow Tracking & Registry (Local SQLite backend)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Serving & Cascade Configuration
CASCADE_CONFIDENCE_THRESHOLD=0.85
LATENCY_P95_LIMIT_MS=800
PORT=8000
HOST=0.0.0.0
SQLITE_DB_PATH=predictions.db

# Drift & Quality Monitoring Thresholds
DRIFT_PSI_THRESHOLD=0.20
DRIFT_FALLBACK_THRESHOLD=0.35
DRIFT_CONFIDENCE_DROP=0.15
DRIFT_WINDOW_SIZE=150
